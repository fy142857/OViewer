#include "UploadValidationCommon.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.oviewer.oviewer.uploadvalidation
PRODUCT_MODULE_NAME = UploadValidationHost
PRODUCT_NAME = $(TARGET_NAME)
INFOPLIST_FILE = UploadValidationHost/Info.plist
CODE_SIGN_ENTITLEMENTS = UploadValidationHost/UploadValidationHost.entitlements
DEFINES_MODULE = YES
ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
